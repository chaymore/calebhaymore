---
import Layout from '../layouts/Layout.astro';
import CornerLinks from '../components/CornerLinks.astro';
import { visibleProjects, type Project } from '../data/projects';

const description = 'A timeline of the things Caleb Haymore has built, newest first.';

// Group consecutive projects under one marker per era. `side` alternates
// across the whole timeline, not per era, so cards zigzag without a break.
const eras: { era: string; items: (Project & { side: 'left' | 'right' })[] }[] = [];
visibleProjects.forEach((project, index) => {
  const item = { ...project, side: index % 2 === 0 ? 'left' : 'right' } as const;
  const last = eras.at(-1);
  if (last?.era === project.era) last.items.push(item);
  else eras.push({ era: project.era, items: [item] });
});
---

<Layout minimal bodyClass="plain" title="Caleb Haymore | Projects" description={description}>
  <a class="home-link" href="/">Caleb Haymore</a>
  <CornerLinks />

  <main class="projects">
    <header>
      <h1>Projects</h1>
      <p>Things I’ve built, newest first. Scroll down to go back in time.</p>
    </header>

    <div class="timeline">
      {eras.map(({ era, items }) => (
        <section class="era" aria-labelledby={`era-${era}`}>
          <h2 class="era-label" id={`era-${era}`}><span>{era}</span></h2>
          <ol class="entries">
            {items.map((project) => (
              <li class:list={['entry', project.side]} id={project.slug}>
                <p class="date-mark"><span>{project.date}</span></p>
                <details class="card">
                  <summary>
                    <span class="card-text">
                      {project.draft && <span class="draft">Draft</span>}
                      <span class="title">{project.title}</span>
                      <span class="summary">{project.summary}</span>
                      {project.callout && <span class="callout">{project.callout}</span>}
                    </span>
                    {project.image && (
                      <img class="thumb" src={project.image.src} alt={project.image.alt} loading="lazy" />
                    )}
                    <span class="toggle" aria-hidden="true"></span>
                  </summary>

                  <div class="more">
                    {project.details?.map((paragraph) => <p>{paragraph}</p>)}

                    {project.gallery && (
                      <div class="gallery">
                        {project.gallery.map((photo) => (
                          <figure>
                            <img src={photo.src} alt={photo.alt} loading="lazy" />
                            {photo.caption && <figcaption>{photo.caption}</figcaption>}
                          </figure>
                        ))}
                      </div>
                    )}

                    {project.audio?.map((clip) => (
                      <figure class="clip">
                        <figcaption>{clip.label}</figcaption>
                        <audio controls preload="none" src={clip.src}></audio>
                      </figure>
                    ))}

                    {project.excerpt && (
                      <figure class="excerpt">
                        <blockquote lang={project.excerpt.lang}>{project.excerpt.text}</blockquote>
                        <figcaption>{project.excerpt.caption}</figcaption>
                      </figure>
                    )}

                    {(project.links?.length || project.tags?.length) && (
                      <div class="foot">
                        {project.links?.map((link) => <a href={link.href}>{link.label} →</a>)}
                        {project.tags && <span class="tags">{project.tags.join(' · ')}</span>}
                      </div>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  :root {
    /* Lets the open/close animation run to height: auto where browsers support it. */
    interpolate-size: allow-keywords;
  }

  .projects {
    --gutter: 7.5rem;
    width: min(100%, 66rem);
    margin: 0 auto;
    padding: 6rem 1.25rem 6rem;
  }

  header {
    text-align: center;
  }

  header h1 {
    margin: 0;
    color: #111;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  header p {
    margin: 0.4rem 0 0;
    color: #8a8a8a;
    font-size: 0.95rem;
  }

  /* One continuous line down the middle. Labels sit on it with a white
     background, which is what makes the years and dates break the line. */
  .timeline {
    position: relative;
    margin-top: 3rem;
    padding-bottom: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: #e3e3e3;
  }

  .era-label {
    position: relative;
    margin: 0;
    padding: 1.5rem 0 1.25rem;
    text-align: center;
  }

  .era-label span {
    display: inline-block;
    padding: 0.5rem 0;
    background: #fff;
    color: #111;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 1fr var(--gutter) 1fr;
    align-items: start;
    padding-bottom: 1.75rem;
    scroll-margin-top: 4rem;
  }

  .date-mark {
    grid-row: 1;
    grid-column: 2;
    justify-self: center;
    margin: 1rem 0 0;
  }

  .date-mark span {
    display: inline-block;
    padding: 0.35rem 0;
    background: #fff;
    color: #9a9a9a;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .entry:hover .date-mark span,
  .entry:has(.card[open]) .date-mark span {
    color: #111;
  }

  .entry.left .card {
    grid-row: 1;
    grid-column: 1;
  }

  .entry.right .card {
    grid-row: 1;
    grid-column: 3;
  }

  .card {
    border: 1px solid #eee;
    border-radius: 16px;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .card:hover,
  .card[open] {
    border-color: #e2e2e2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .card::details-content {
    height: 0;
    overflow: clip;
    transition: height 0.3s ease, content-visibility 0.3s allow-discrete;
  }

  .card[open]::details-content {
    height: auto;
  }

  summary {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.1rem;
    list-style: none;
    cursor: pointer;
    border-radius: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }

  .card-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
  }

  .draft {
    align-self: flex-start;
    margin-bottom: 0.2rem;
    padding: 0.05rem 0.35rem;
    border: 1px dashed #c4c4c4;
    border-radius: 4px;
    color: #9a9a9a;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .title {
    color: #111;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .summary {
    color: #6d6d6d;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .callout {
    align-self: flex-start;
    margin-top: 0.4rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #f3f3f3;
    color: #333;
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* Photos stay quiet and gray until the card is hovered or opened. */
  .thumb {
    flex: none;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 10px;
    object-fit: cover;
    background: #f3f3f3;
    filter: grayscale(1);
    opacity: 0.85;
    transition: filter 0.3s, opacity 0.3s;
  }

  .card:hover .thumb,
  .card[open] .thumb {
    filter: none;
    opacity: 1;
  }

  .toggle {
    flex: none;
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.3rem;
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: #b0b0b0;
    transition: transform 0.25s;
  }

  .toggle::after {
    transform: rotate(90deg);
  }

  .card[open] .toggle::after {
    transform: rotate(0deg);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 0 1.1rem 1.2rem;
    color: #4a4a4a;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .more p {
    margin: 0;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.6rem;
  }

  figure {
    margin: 0;
  }

  .gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    object-fit: cover;
    background: #f3f3f3;
  }

  figcaption {
    margin-top: 0.35rem;
    color: #8a8a8a;
    font-size: 0.8rem;
  }

  .clip figcaption {
    margin: 0 0 0.35rem;
  }

  .clip audio {
    width: 100%;
    height: 2.5rem;
  }

  .excerpt blockquote {
    margin: 0;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: #f6f6f6;
    color: #333;
    white-space: pre-wrap;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.1rem;
    padding-top: 0.2rem;
    font-size: 0.85rem;
  }

  .foot a {
    color: #111;
    text-decoration: underline;
    text-decoration-color: #cfcfcf;
    text-underline-offset: 3px;
  }

  .foot a:hover {
    text-decoration-color: #111;
  }

  .tags {
    color: #9a9a9a;
    font-size: 0.8rem;
  }

  /* Phones: not enough room for two columns, so the line moves to the left
     edge and every card sits to its right, with its date above it. */
  @media (max-width: 760px) {
    .timeline::before {
      left: 0.35rem;
    }

    .era-label {
      text-align: left;
    }

    .entries {
      padding-left: 1.4rem;
    }

    .entry {
      grid-template-columns: 1fr;
      padding-bottom: 1.25rem;
    }

    .date-mark {
      grid-column: 1;
      justify-self: start;
      margin: 0 0 0.35rem;
    }

    .entry.left .card,
    .entry.right .card {
      grid-row: 2;
      grid-column: 1;
    }

    .thumb {
      width: 3.75rem;
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card::details-content,
    .thumb,
    .toggle::after {
      transition: none;
    }
  }
</style>

<script>
  // Opening a link like /projects#marriott-case expands that card.
  const target = location.hash && document.getElementById(location.hash.slice(1));
  target?.querySelector('details')?.setAttribute('open', '');
</script>
